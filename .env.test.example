# M5A Browser QA Test Environment
# Copy this file to .env.test.local and fill in your test values.
# .env.test.local is gitignored.

# Supabase Configuration (required for Vitest live tests)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# M5A Test Account (required for live RLS and browser tests)
TEST_USER_EMAIL=m5a-test@example.com
TEST_USER_PASSWORD=your-test-user-password

# M5A Test Family (required for live RLS and browser tests)
TEST_FAMILY_ID=00000000-0000-0000-0000-000000000000
